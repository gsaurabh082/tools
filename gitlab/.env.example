# Private GitLab group to inspect. Subgroups are included automatically.
GITLAB_GROUP_URL=https://gitlab.apps.ge-healthcare.net/pia_restricted

# Create a token with read_api scope. Add api scope only if approval actions are enabled.
GITLAB_TOKEN=

# Safe by default. Set to true only when you want the Approve button to change GitLab.
GITLAB_ENABLE_WRITE_ACTIONS=false

# Optional for corporate TLS. Prefer your CA file; disabling verification is not recommended.
GITLAB_CA_BUNDLE=
GITLAB_VERIFY_SSL=true

# Dashboard runtime
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_CACHE_SECONDS=90
DASHBOARD_STALE_DAYS=5
