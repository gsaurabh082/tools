<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="WinDock" Manufacturer="Saurabh Gupta" Version="!(bind.FileVersion.DesktopExe)" UpgradeCode="D23EFEE5-BF98-4452-B91C-2B0E203C32E1" Scope="perMachine" Language="1033" Copyright="Copyright © 2026 Saurabh Gupta">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WinDock is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinDock">
        <Component Id="CliComponent" Bitness="always64">
          <File Id="WinDockCli" Source="$(var.PublishDir)\wincolima.exe" KeyPath="yes" />
        </Component>
        <Component Id="DesktopComponent" Bitness="always64">
          <File Id="DesktopExe" Source="$(var.PublishDir)\WinDock.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="WinDock" Level="1">
      <ComponentRef Id="CliComponent" />
      <ComponentRef Id="DesktopComponent" />
    </Feature>
  </Package>
</Wix>
