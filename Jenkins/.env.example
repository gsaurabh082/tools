# Jenkins credentials (Jenkins user + API token, from Jenkins > your user > Configure > API Token)
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_VERIFY_SSL=true
# Leave blank to auto-use ../certs/ge-corp-ca-bundle.pem (GE HealthCare corporate CA)
# when that file exists next to this app. Set explicitly to override, or set to a
# literal empty value to force the public certifi trust store instead.
JENKINS_CA_BUNDLE=

# Polling / retry behaviour
JENKINS_POLL_SECONDS=15
JENKINS_MAX_RETRIES=2
JENKINS_RETRY_DELAY_SECONDS=30
JENKINS_MAX_WAIT_MINUTES=180
# Used only for the "search Jenkins jobs" typeahead in the chain editor.
JENKINS_DEFAULT_ORIGIN=https://jenkins-dose.apps.ge-healthcare.net

# GitLab (personal access token with `api` scope, needed to merge MRs)
GITLAB_TOKEN=
GITLAB_DEFAULT_ORIGIN=https://gitlab.apps.ge-healthcare.net
GITLAB_VERIFY_SSL=true
# Same corporate-CA auto-detection as JENKINS_CA_BUNDLE above.
GITLAB_CA_BUNDLE=

# Local dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=
